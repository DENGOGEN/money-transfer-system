<Window x:Class="MoneyTransferApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Money Transfer System" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="💰 Money Transfer" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserPhoneText" 
                               Foreground="White" VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="BalanceText" 
                               Foreground="#2ECC71" FontWeight="Bold" 
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="LogoutButton" Content="Выход" 
                            Background="#E74C3C" Foreground="White"
                            Padding="10,5" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- Вкладка Перевод -->
            <TabItem Header="💸 Перевод">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Получатель" 
                               FontWeight="Bold" Margin="0,5"/>
                    <ComboBox x:Name="TransferTypeBox" Grid.Row="1" 
                              Margin="0,5" SelectedIndex="0">
                        <ComboBoxItem Content="📱 По номеру телефона"/>
                        <ComboBoxItem Content="💳 На банковскую карту"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="Номер телефона / Карты" 
                               FontWeight="Bold" Margin="0,10,0,5"/>
                    <TextBox x:Name="RecipientBox" Grid.Row="3" 
                             Margin="0,5" Padding="8" FontSize="14"/>

                    <TextBlock Grid.Row="4" Text="Сумма (₽)" 
                               FontWeight="Bold" Margin="0,10,0,5"/>
                    <TextBox x:Name="AmountBox" Grid.Row="5" 
                             Margin="0,5" Padding="8" FontSize="14"/>

                    <TextBlock x:Name="CommissionText" Grid.Row="6" 
                               Foreground="Gray" Margin="0,5"/>

                    <Button x:Name="TransferButton" Grid.Row="7" 
                            Content="Перевести" Width="200" Height="40" 
                            HorizontalAlignment="Center" Margin="0,20"
                            Background="#0078D4" Foreground="White"
                            FontSize="16" Click="TransferButton_Click"/>
                </Grid>
            </TabItem>

            <!-- Вкладка История -->
            <TabItem Header="📜 История">
                <DataGrid x:Name="HistoryGrid" Margin="10" 
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:F2} ₽}"/>
                        <DataGridTextColumn Header="Комиссия" Binding="{Binding Commission, StringFormat={}{0:F2} ₽}"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Вкладка Профиль -->
            <TabItem Header="👤 Профиль">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0" Text="Информация о профиле" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- Блок информации о профиле -->
                    <Border Grid.Row="1" Background="#F0F0F0" 
                Padding="15" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Номер телефона:" 
                           FontWeight="Bold"/>
                            <TextBlock x:Name="ProfilePhone" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Баланс:" 
                           FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ProfileBalance" Grid.Row="1" Grid.Column="1" 
                           Foreground="#2ECC71" FontWeight="Bold" Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Статус верификации:" 
                           FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ProfileVerified" Grid.Row="2" Grid.Column="1" 
                           Margin="0,10,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Блок виртуальной карты -->
                    <Border Grid.Row="2" Background="#E8F4FD" 
        Padding="15" CornerRadius="5" Margin="0,15,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Заголовок -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                   Text="💳 Виртуальная карта" 
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <!-- Номер карты -->
                            <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Номер карты:" 
                   VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProfileCardNumber" Grid.Row="1" Grid.Column="1" 
                   FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                   VerticalAlignment="Center"/>
                            <Button x:Name="ShowCardNumberButton" Grid.Row="1" Grid.Column="2"
                Content="👁️ Показать" 
                Width="80" Height="25" Margin="10,0,0,0"
                Background="#3498DB" Foreground="White"
                FontSize="11" Cursor="Hand"
                Click="ShowCardNumberButton_Click"/>

                            <!-- Срок действия -->
                            <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Срок действия:" 
                   VerticalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ProfileCardExpiry" Grid.Row="2" Grid.Column="1" 
                   VerticalAlignment="Center" Margin="0,10,0,0"/>

                            <!-- CVV -->
                            <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="CVV:" 
                   VerticalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ProfileCardCvv" Grid.Row="3" Grid.Column="1" 
                   VerticalAlignment="Center" Margin="0,10,0,0"/>
                            <Button x:Name="ShowCvvButton" Grid.Row="3" Grid.Column="2"
                Content="👁️ Показать" 
                Width="80" Height="25" Margin="10,0,0,0"
                Background="#E67E22" Foreground="White"
                FontSize="11" Cursor="Hand"
                Click="ShowCvvButton_Click"/>
   

                        </Grid>
                    </Border>

                    <!-- Кнопки действий (Пополнить и Обновить) -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,25,0,0">
                        <Button x:Name="TopUpButton" Content="💳 Пополнить баланс" 
                    Width="160" Height="40" Margin="10"
                    Background="#2ECC71" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Cursor="Hand"
                    Click="TopUpButton_Click"/>
                        <Button x:Name="RefreshBalanceButton" Content="🔄 Обновить" 
                    Width="120" Height="40" Margin="10"
                    Background="#3498DB" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Cursor="Hand"
                    Click="RefreshBalanceButton_Click"/>
                    </StackPanel>

                </Grid>
            </TabItem>
        </TabControl>

        <!-- 2FA диалог -->
        <Grid x:Name="TwoFactorGrid" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" Width="350" Height="200" 
                    CornerRadius="10" HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <StackPanel Margin="20">
                    <TextBlock Text="Подтверждение 2FA" FontSize="18" 
                               FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Введите код из SMS" Margin="0,0,0,10"/>
                    <TextBox x:Name="TwoFactorCodeBox" FontSize="16" 
                             Padding="5" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="Confirm2FAButton" Content="Подтвердить" 
                                Width="100" Margin="5" Click="Confirm2FAButton_Click"/>
                        <Button x:Name="Cancel2FAButton" Content="Отмена" 
                                Width="100" Margin="5" Click="Cancel2FAButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>