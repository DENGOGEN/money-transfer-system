<Window x:Class="MoneyTransferApp.Views.TopUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пополнение баланса" Height="480" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="💰 Пополнение баланса" 
                   FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

        <!-- Сумма -->
        <TextBlock Grid.Row="1" Text="Сумма пополнения (₽)" 
                   FontSize="14" FontWeight="Bold" Margin="0,5"/>
        <TextBox x:Name="AmountBox" Grid.Row="2" 
                 FontSize="16" Padding="8" 
                 Margin="0,5,0,15"
                 ToolTip="Введите сумму от 100 до 100 000 ₽"/>

        <!-- Быстрые суммы -->
        <TextBlock Grid.Row="3" Text="Быстрые суммы:" 
                   FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button Content="500 ₽" Width="70" Height="30" Margin="3"
                    Click="QuickAmount_Click" Tag="500"
                    Background="#E0E0E0" Foreground="Black"/>
            <Button Content="1000 ₽" Width="70" Height="30" Margin="3"
                    Click="QuickAmount_Click" Tag="1000"
                    Background="#E0E0E0" Foreground="Black"/>
            <Button Content="5000 ₽" Width="70" Height="30" Margin="3"
                    Click="QuickAmount_Click" Tag="5000"
                    Background="#E0E0E0" Foreground="Black"/>
            <Button Content="10000 ₽" Width="70" Height="30" Margin="3"
                    Click="QuickAmount_Click" Tag="10000"
                    Background="#E0E0E0" Foreground="Black"/>
        </StackPanel>

        <!-- Номер карты -->
        <TextBlock Grid.Row="5" Text="Номер банковской карты" 
                   FontSize="14" FontWeight="Bold" Margin="0,5"/>
        <TextBox x:Name="CardNumberBox" Grid.Row="6" 
                 FontSize="14" Padding="8" 
                 Margin="0,5,0,15"
                 MaxLength="19"
                 TextChanged="CardNumberBox_TextChanged"
                 ToolTip="Введите 16-значный номер карты"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20,0,10">
            <Button x:Name="TopUpButton" Content="💳 Пополнить" 
                    Width="130" Height="45" Margin="10"
                    Background="#2ECC71" Foreground="White"
                    FontSize="15" FontWeight="Bold"
                    Click="TopUpButton_Click"
                    Cursor="Hand"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" 
                    Width="130" Height="45" Margin="10"
                    Background="#E74C3C" Foreground="White"
                    FontSize="15" FontWeight="Bold"
                    Click="CancelButton_Click"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="ErrorText" Grid.Row="8" 
                   Text="" Foreground="Red" 
                   HorizontalAlignment="Center" 
                   FontSize="12" Margin="0,10"/>
    </Grid>
</Window>